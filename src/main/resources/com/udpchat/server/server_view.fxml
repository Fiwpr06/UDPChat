<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udpchat.server.controller.ServerController"
      styleClass="root" spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Title Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="UDP Server" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Region fx:id="statusIndicator" styleClass="status-indicator, status-offline" prefWidth="12" prefHeight="12" style="-fx-background-radius: 6;"/>
        <Label fx:id="statusLabel" text="Stopped"/>
    </HBox>

    <!-- Server Control & IP Display -->
    <HBox styleClass="section-panel" spacing="10" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        
        <Label text="IP Máy chủ:"/>
        <Label fx:id="ipLabel" text="127.0.0.1" styleClass="badge-ip"/>
        <Button fx:id="copyIpButton" text="📋 Copy IP" onAction="#onCopyIp" styleClass="button-secondary"/>

        <Region prefWidth="10"/>
        
        <Label text="Cổng (Port):"/>
        <TextField fx:id="portField" prefWidth="75"/>
        <Button fx:id="startButton" text="Start Server" onAction="#onStart"/>
        <Button fx:id="stopButton" text="Stop Server" onAction="#onStop"/>
    </HBox>

    <!-- Online Clients -->
    <VBox styleClass="section-panel" spacing="6">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="onlineCountLabel" text="Online: 0" style="-fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="copyClientIpButton" text="📋 Copy IP Client chọn" onAction="#onCopyClientIp" styleClass="button-secondary"/>
        </HBox>
        <ListView fx:id="clientListView" prefHeight="120"/>
    </VBox>

    <!-- Activity Log -->
    <VBox fx:id="logContainer" styleClass="section-panel" spacing="6" VBox.vgrow="ALWAYS">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Nhật ký hoạt động mạng (Activity Log)" style="-fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="openLogFileButton" text="📂 Mở file Log" onAction="#onOpenLogFile" styleClass="button-secondary"/>
            <Button fx:id="toggleLogButton" text="👁️ Ẩn/Hiện Log" onAction="#onToggleLog" styleClass="button-secondary"/>
            <Button fx:id="clearLogButton" text="🗑️ Xóa log" onAction="#onClearLog" styleClass="button-secondary"/>
        </HBox>
        <TextArea fx:id="logArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="log-area, mono-text"/>
    </VBox>
</VBox>

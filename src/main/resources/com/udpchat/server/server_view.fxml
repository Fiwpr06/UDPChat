<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udpchat.server.controller.ServerController"
      styleClass="app-root" spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <!-- Title Bar Header -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="card-panel">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <Label text="✉ MAIL" styleClass="brand-icon-badge"/>
        <VBox spacing="2">
            <Label text="UDP MAIL SERVER" styleClass="brand-title-medium"/>
            <Label text="Máy chủ Thư điện tử &amp; Quản lý tệp đính kèm thuần UDP (Mô hình Gmail)" styleClass="brand-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="8" styleClass="status-badge-container">
            <Region fx:id="statusIndicator" styleClass="status-indicator, status-offline" prefWidth="10" prefHeight="10"/>
            <Label fx:id="statusLabel" text="Đã dừng" styleClass="status-badge-text"/>
        </HBox>
    </HBox>

    <!-- Server Control & IP Display -->
    <HBox styleClass="card-panel" spacing="12" alignment="CENTER_LEFT">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        
        <Label text="IP Máy chủ:" styleClass="input-label"/>
        <Label fx:id="ipLabel" text="127.0.0.1" styleClass="badge-ip"/>
        <Button fx:id="copyIpButton" text="Sao chép IP" onAction="#onCopyIp" styleClass="button-secondary" minWidth="-Infinity"/>

        <Region HBox.hgrow="ALWAYS"/>
        
        <Label text="Cổng (Port):" styleClass="input-label"/>
        <TextField fx:id="portField" text="8888" prefWidth="85" styleClass="form-input"/>
        <Button fx:id="startButton" text="Khởi động Server" onAction="#onStart" styleClass="button-primary" minWidth="-Infinity"/>
        <Button fx:id="stopButton" text="Dừng Server" onAction="#onStop" styleClass="button-danger" minWidth="-Infinity"/>
    </HBox>

    <!-- Statistics Panel -->
    <HBox styleClass="card-panel" spacing="20" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="✉ Tổng số thư:" styleClass="input-label"/>
            <Label fx:id="totalEmailsLabel" text="0" styleClass="badge-ip"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="📅 Thư hôm nay:" styleClass="input-label"/>
            <Label fx:id="todayEmailsLabel" text="0" styleClass="badge-ip"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="📎 Tệp đính kèm:" styleClass="input-label"/>
            <Label fx:id="attachmentsCountLabel" text="0" styleClass="badge-ip"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="💾 Dung lượng lưu trữ:" styleClass="input-label"/>
            <Label fx:id="storageSizeLabel" text="0 KB" styleClass="badge-ip"/>
        </HBox>
    </HBox>

    <!-- Online Clients -->
    <VBox styleClass="card-panel" spacing="8">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="onlineCountLabel" text="Người dùng đang online: 0" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="copyClientIpButton" text="Sao chép IP Client chọn" onAction="#onCopyClientIp" styleClass="button-secondary" minWidth="-Infinity"/>
        </HBox>
        <ListView fx:id="clientListView" prefHeight="100" styleClass="modern-list-view"/>
    </VBox>

    <!-- Activity Log -->
    <VBox fx:id="logContainer" styleClass="card-panel" spacing="8" VBox.vgrow="ALWAYS">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Nhật Ký Máy Chủ &amp; Giao Thức UDP" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="toggleLogButton" text="Ẩn/Hiện Log" onAction="#onToggleLog" styleClass="button-secondary" minWidth="-Infinity"/>
            <Button fx:id="clearLogButton" text="Xóa Log" onAction="#onClearLog" styleClass="button-secondary" minWidth="-Infinity"/>
        </HBox>
        <TextArea fx:id="logArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="log-area, mono-text"/>
    </VBox>
</VBox>

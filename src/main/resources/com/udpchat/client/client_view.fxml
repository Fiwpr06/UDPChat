<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.udpchat.client.controller.ClientController"
           styleClass="app-root">

    <!-- ============================================== -->
    <!-- SCREEN 1: KẾT NỐI SERVER (CONNECTION GATEWAY)  -->
    <!-- ============================================== -->
    <VBox fx:id="connectScreen" alignment="CENTER" spacing="0" styleClass="screen-container">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        <VBox alignment="CENTER" spacing="20" maxWidth="460" styleClass="card-panel, entrance-card">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

            <!-- App Logo / Badge -->
            <VBox alignment="CENTER" spacing="6">
                <HBox alignment="CENTER" spacing="10">
                    <Label text="✉ MAIL" styleClass="brand-icon-badge"/>
                    <Label text="UDP MAIL" styleClass="brand-title"/>
                </HBox>
                <Label text="Hệ thống Thư điện tử thuần UDP (Lấy cảm hứng từ Gmail)" styleClass="brand-subtitle"/>
            </VBox>

            <Separator styleClass="panel-separator"/>

            <!-- Step Title -->
            <VBox alignment="CENTER_LEFT" spacing="4">
                <Label text="Bước 1: Kết nối tới Máy chủ Thư" styleClass="card-title"/>
                <Label text="Nhập địa chỉ IP và Cổng (Port) của máy chủ UDP để truy cập hộp thư." styleClass="card-desc"/>
            </VBox>

            <!-- Form -->
            <VBox spacing="12">
                <VBox spacing="6">
                    <Label text="Địa chỉ Máy chủ (Mail Server IP / Host):" styleClass="input-label"/>
                    <TextField fx:id="serverHostField" text="localhost" promptText="ví dụ: localhost hoặc 192.168.1.100" styleClass="form-input" onAction="#onConnectServer"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Cổng dịch vụ (Port):" styleClass="input-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="portField" text="8888" promptText="8888" prefWidth="120" styleClass="form-input" onAction="#onConnectServer"/>
                        <Button text="Mặc định: 8888" onAction="#onUseDefaultPort" styleClass="button-secondary" minWidth="-Infinity"/>
                    </HBox>
                </VBox>

                <!-- Local IP helper -->
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="info-banner">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    <Label text="IP máy của bạn:" styleClass="info-label"/>
                    <Label fx:id="myIpLabel" text="127.0.0.1" styleClass="badge-ip"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyMyIpButton" text="Sao chép" onAction="#onCopyMyIp" styleClass="button-secondary" minWidth="-Infinity"/>
                </HBox>
            </VBox>

            <!-- Error Hint -->
            <Label fx:id="connectErrorLabel" text="" styleClass="error-text" wrapText="true" visible="false" managed="false"/>

            <!-- Connect Action -->
            <Button fx:id="btnConnectServer" text="Tiếp tục tới Đăng nhập →" onAction="#onConnectServer" maxWidth="Infinity" styleClass="button-primary"/>
        </VBox>
    </VBox>

    <!-- ============================================== -->
    <!-- SCREEN 2: XÁC THỰC (AUTH: LOGIN / REGISTER)    -->
    <!-- ============================================== -->
    <VBox fx:id="authScreen" alignment="CENTER" spacing="0" styleClass="screen-container" visible="false" managed="false">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        <VBox alignment="CENTER" spacing="18" maxWidth="460" styleClass="card-panel, entrance-card">
            <padding><Insets top="26" right="28" bottom="26" left="28"/></padding>

            <!-- Header with Back & Server Badge -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="← Đổi máy chủ" onAction="#onBackToConnect" styleClass="button-secondary" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="6" styleClass="status-badge-container">
                    <Region styleClass="status-indicator, status-online"/>
                    <Label fx:id="authServerBadge" text="localhost:8888" styleClass="status-badge-text"/>
                </HBox>
            </HBox>

            <!-- Brand Icon Mini -->
            <VBox alignment="CENTER" spacing="4">
                <Label fx:id="authModeTitle" text="Đăng nhập Hộp thư" styleClass="brand-title-medium"/>
                <Label fx:id="authModeSubtitle" text="Nhập tài khoản để truy cập hệ thống thư điện tử UDP" styleClass="brand-subtitle"/>
            </VBox>

            <!-- Tab Switcher -->
            <HBox styleClass="tab-switcher">
                <Button fx:id="tabLoginButton" text="Đăng nhập" onAction="#onSelectLoginTab" styleClass="tab-btn, tab-btn-active" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="tabRegisterButton" text="Đăng ký tài khoản" onAction="#onSelectRegisterTab" styleClass="tab-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <!-- Form -->
            <VBox spacing="12">
                <VBox spacing="6">
                    <Label text="Tên tài khoản (Email username):" styleClass="input-label"/>
                    <TextField fx:id="usernameField" promptText="Ví dụ: alice hoặc bob" styleClass="form-input"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Mật khẩu (Password):" styleClass="input-label"/>
                    <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu" styleClass="form-input" onAction="#onAuthAction"/>
                </VBox>
            </VBox>

            <!-- Status Banner -->
            <Label fx:id="authStatusLabel" text="" styleClass="auth-feedback" wrapText="true" visible="false" managed="false"/>

            <!-- Action Button -->
            <Button fx:id="authActionButton" text="Đăng nhập ngay" onAction="#onAuthAction" maxWidth="Infinity" styleClass="button-primary"/>
        </VBox>
    </VBox>

    <!-- ============================================== -->
    <!-- SCREEN 3: MÀN HÌNH MAIL CHÍNH (GMAIL 3-PANEL)  -->
    <!-- ============================================== -->
    <BorderPane fx:id="mainMailScreen" styleClass="main-workspace" visible="false" managed="false">

        <!-- TOP APPLICATION & SEARCH BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-app-bar">
                <!-- Brand Badge -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="✉" styleClass="brand-icon-badge"/>
                    <Label text="UDP Mail" styleClass="brand-title-medium"/>
                </HBox>

                <!-- Search Bar (Gmail Style) -->
                <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS" maxWidth="560" styleClass="search-field-container">
                    <Label text="🔍" styleClass="info-label"/>
                    <TextField fx:id="searchField" promptText="Tìm kiếm trong thư (tiêu đề, nội dung, người gửi)..."
                               styleClass="search-input" HBox.hgrow="ALWAYS" onAction="#onSearchMail"/>
                    <Button fx:id="btnSearch" text="Tìm" onAction="#onSearchMail" styleClass="button-secondary" minWidth="-Infinity"/>
                    <Button fx:id="btnClearSearch" text="✕" onAction="#onClearSearch" styleClass="button-secondary" minWidth="-Infinity" visible="false" managed="false"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Notification status badge -->
                <HBox alignment="CENTER" spacing="8" styleClass="status-badge-container">
                    <Region styleClass="status-indicator, status-online" prefWidth="8" prefHeight="8"/>
                    <Label fx:id="currentUserBadge" text="alice" styleClass="status-badge-text"/>
                </HBox>
            </HBox>
        </top>

        <!-- LEFT SIDEBAR: FOLDERS & ACTIONS -->
        <left>
            <VBox styleClass="sidebar-panel" spacing="12" prefWidth="210" minWidth="200">
                <padding><Insets top="14" right="10" bottom="14" left="10"/></padding>

                <!-- Big Compose Mail Button -->
                <Button fx:id="btnOpenCompose" text="✏️  Soạn thư" onAction="#onOpenCompose"
                        maxWidth="Infinity" styleClass="compose-button"/>

                <Separator styleClass="panel-separator"/>

                <!-- Folder List -->
                <VBox spacing="4" VBox.vgrow="ALWAYS">
                    <Button fx:id="btnFolderInbox" onAction="#onSelectFolderInbox" maxWidth="Infinity" styleClass="folder-nav-btn, folder-nav-btn-active">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                                <Label text="📥"/>
                                <Label text="Hộp thư đến" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="inboxBadgeCount" text="" styleClass="folder-badge-count" visible="false" managed="false"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnFolderStarred" onAction="#onSelectFolderStarred" maxWidth="Infinity" styleClass="folder-nav-btn">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                                <Label text="⭐"/>
                                <Label text="Có gắn dấu sao" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnFolderSent" onAction="#onSelectFolderSent" maxWidth="Infinity" styleClass="folder-nav-btn">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                                <Label text="📤"/>
                                <Label text="Đã gửi" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnFolderDrafts" onAction="#onSelectFolderDrafts" maxWidth="Infinity" styleClass="folder-nav-btn">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                                <Label text="📝"/>
                                <Label text="Bản nháp" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="draftsBadgeCount" text="" styleClass="folder-badge-count" visible="false" managed="false"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnFolderTrash" onAction="#onSelectFolderTrash" maxWidth="Infinity" styleClass="folder-nav-btn">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                                <Label text="🗑️"/>
                                <Label text="Thùng rác" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>

                <!-- Mini Stats / Server info -->
                <VBox styleClass="user-profile-card" spacing="6">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Hộp thư:" styleClass="caption-muted"/>
                        <Label fx:id="userEmailDisplayLabel" text="alice" styleClass="badge-server-mini"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Máy chủ:" styleClass="caption-muted"/>
                        <Label fx:id="serverAddressDisplayLabel" text="127.0.0.1:8888" styleClass="badge-server-mini"/>
                    </HBox>
                </VBox>

                <!-- Bottom Controls -->
                <VBox spacing="6">
                    <Button fx:id="btnToggleLog" text="📋 Nhật ký UDP" onAction="#onToggleLogDrawer" styleClass="button-secondary" maxWidth="Infinity"/>
                    <Button fx:id="btnLogout" text="Đăng xuất" onAction="#onLogout" styleClass="button-danger" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </left>

        <!-- CENTER: MAIL LIST (PANEL GIỮA) -->
        <center>
            <VBox styleClass="mail-list-panel">
                <!-- Mail List Header -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="mail-list-header">
                    <Label fx:id="currentFolderTitle" text="📥 Hộp thư đến" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄" onAction="#onRefreshCurrentFolder" styleClass="button-secondary" minWidth="-Infinity"/>
                    <HBox alignment="CENTER" spacing="4">
                        <Button fx:id="btnPrevPage" text="◀" onAction="#onPrevPage" styleClass="button-secondary" minWidth="-Infinity"/>
                        <Label fx:id="pageInfoLabel" text="1 / 1" styleClass="info-label"/>
                        <Button fx:id="btnNextPage" text="▶" onAction="#onNextPage" styleClass="button-secondary" minWidth="-Infinity"/>
                    </HBox>
                </HBox>

                <!-- Mail Items Container (ScrollPane) -->
                <ScrollPane fx:id="mailListScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="chat-container">
                    <VBox fx:id="mailListBox" spacing="0">
                        <!-- Populated dynamically with mail item cards -->
                    </VBox>
                </ScrollPane>

                <!-- Empty Placeholder -->
                <VBox fx:id="emptyMailboxPlaceholder" alignment="CENTER" spacing="8" styleClass="empty-placeholder" visible="false" managed="false">
                    <Label text="📭" style="-fx-font-size: 32px;"/>
                    <Label text="Thư mục này hiện đang trống" styleClass="empty-placeholder-title"/>
                    <Label text="Không có thư điện tử nào ở đây." styleClass="empty-placeholder-desc"/>
                </VBox>
            </VBox>
        </center>

        <!-- RIGHT: MAIL DETAIL (PANEL CHI TIẾT THƯ) -->
        <right>
            <VBox styleClass="mail-detail-panel" prefWidth="480" HBox.hgrow="ALWAYS">
                <!-- Detail Header Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="mail-detail-header">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Button fx:id="btnReply" text="↩️ Trả lời" onAction="#onReplyMail" styleClass="button-secondary" minWidth="-Infinity"/>
                        <Button fx:id="btnReplyAll" text="↩️↩️ Trả lời tất cả" onAction="#onReplyAllMail" styleClass="button-secondary" minWidth="-Infinity"/>
                        <Button fx:id="btnForward" text="➡️ Chuyển tiếp" onAction="#onForwardMail" styleClass="button-secondary" minWidth="-Infinity"/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnToggleStarDetail" text="⭐" onAction="#onToggleStarDetail" styleClass="button-secondary" minWidth="-Infinity"/>
                    <Button fx:id="btnDeleteDetail" text="🗑️ Xóa" onAction="#onDeleteCurrentMail" styleClass="button-danger" minWidth="-Infinity"/>
                </HBox>

                <!-- Detail Content Container -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="chat-container">
                    <VBox fx:id="mailDetailContainer" spacing="14">
                        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

                        <!-- Subject -->
                        <Label fx:id="detailSubjectLabel" text="Chọn một thư để xem nội dung" styleClass="mail-detail-subject" wrapText="true"/>

                        <!-- Sender & Metadata Card -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="info-banner">
                            <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                            <StackPane styleClass="avatar-circle">
                                <Label fx:id="detailAvatarLabel" text="?" styleClass="avatar-text"/>
                            </StackPane>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <Label fx:id="detailSenderLabel" text="Người gửi" styleClass="user-name-label"/>
                                    <Label fx:id="detailTimeLabel" text="" styleClass="caption-muted"/>
                                </HBox>
                                <Label fx:id="detailRecipientsLabel" text="Đến: tôi" styleClass="caption-muted" wrapText="true"/>
                                <Label fx:id="detailCcLabel" text="" styleClass="caption-muted" wrapText="true" visible="false" managed="false"/>
                            </VBox>
                        </HBox>

                        <Separator styleClass="panel-separator"/>

                        <!-- Email Body Text -->
                        <VBox styleClass="mail-detail-body-container" minHeight="180">
                            <Label fx:id="detailBodyLabel" text="" wrapText="true" styleClass="mail-detail-body-text"/>
                        </VBox>

                        <!-- Attachments Section -->
                        <VBox fx:id="attachmentsSection" spacing="8" visible="false" managed="false">
                            <Separator styleClass="panel-separator"/>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label fx:id="attachmentsHeaderLabel" text="📎 Tệp đính kèm (0):" styleClass="card-title"/>
                            </HBox>
                            <FlowPane fx:id="attachmentsFlowPane" hgap="10" vgap="10"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </right>

        <!-- BOTTOM: COLLAPSIBLE UDP MINI LOGS -->
        <bottom>
            <VBox fx:id="logDrawer" styleClass="channel-panel" visible="false" managed="false" maxHeight="150">
                <HBox alignment="CENTER_LEFT" styleClass="channel-panel-header">
                    <Label text="📋 Nhật ký mạng UDP" styleClass="channel-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Xóa Log" onAction="#onClearLog" styleClass="button-secondary" minWidth="-Infinity"/>
                    <Button text="✕" onAction="#onToggleLogDrawer" styleClass="button-secondary" minWidth="-Infinity"/>
                </HBox>
                <TextArea fx:id="logArea" prefRowCount="4" editable="false" wrapText="true" styleClass="mini-log-box"/>
            </VBox>
        </bottom>
    </BorderPane>

    <!-- ============================================== -->
    <!-- FLOATING COMPOSE EMAIL MODAL (GMAIL STYLE)     -->
    <!-- ============================================== -->
    <VBox fx:id="composeOverlay" alignment="CENTER" styleClass="screen-container"
          style="-fx-background-color: rgba(5, 8, 15, 0.75);" visible="false" managed="false">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <VBox maxWidth="620" prefWidth="600" maxHeight="620" styleClass="compose-modal-card">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="compose-header">
                <Label fx:id="composeTitleLabel" text="✉  Thư mới" styleClass="brand-title-medium"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#onCloseCompose" styleClass="button-secondary" minWidth="-Infinity"/>
            </HBox>

            <!-- Form Fields -->
            <VBox spacing="0">
                <!-- To -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="compose-input-row">
                    <Label text="Đến:" styleClass="input-label" prefWidth="45"/>
                    <TextField fx:id="composeToField" promptText="Nhập tên người nhận (phân cách bằng dấu phẩy, ví dụ: bob, charlie)"
                               styleClass="compose-field" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnToggleCcBcc" text="CC / BCC" onAction="#onToggleCcBcc" styleClass="button-secondary" minWidth="-Infinity"/>
                </HBox>

                <!-- CC / BCC (collapsible) -->
                <VBox fx:id="ccBccContainer" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="compose-input-row">
                        <Label text="CC:" styleClass="input-label" prefWidth="45"/>
                        <TextField fx:id="composeCcField" promptText="Người nhận bản sao..." styleClass="compose-field" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="compose-input-row">
                        <Label text="BCC:" styleClass="input-label" prefWidth="45"/>
                        <TextField fx:id="composeBccField" promptText="Người nhận bản sao ẩn..." styleClass="compose-field" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Subject -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="compose-input-row">
                    <Label text="Chủ đề:" styleClass="input-label" prefWidth="45"/>
                    <TextField fx:id="composeSubjectField" promptText="Tiêu đề thư..." styleClass="compose-field" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Body Area -->
                <TextArea fx:id="composeBodyArea" promptText="Soạn nội dung thư ở đây..."
                          prefRowCount="10" wrapText="true" styleClass="compose-body-area"/>

                <!-- Attached Files Chips -->
                <VBox fx:id="composeAttachmentsBox" spacing="6" styleClass="compose-input-row" visible="false" managed="false">
                    <Label text="Tệp đính kèm:" styleClass="caption-muted"/>
                    <FlowPane fx:id="composeAttachmentsFlowPane" hgap="8" vgap="6"/>
                </VBox>

                <!-- Upload Progress -->
                <ProgressBar fx:id="composeUploadProgress" maxWidth="Infinity" progress="0.0"
                             styleClass="modern-progress-bar" visible="false" managed="false"/>
            </VBox>

            <!-- Bottom Actions -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10px 14px; -fx-background-color: #0E1424; -fx-border-radius: 0 0 10px 10px; -fx-background-radius: 0 0 10px 10px;">
                <Button fx:id="btnSendMailAction" text="📤 Gửi thư" onAction="#onSendMail" styleClass="button-primary" minWidth="-Infinity"/>
                <Button fx:id="btnAttachFile" text="📎 Đính kèm tệp" onAction="#onAttachFile" styleClass="button-secondary" minWidth="-Infinity"/>
                <Button fx:id="btnSaveDraftAction" text="💾 Lưu nháp" onAction="#onSaveDraft" styleClass="button-secondary" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🗑️ Hủy" onAction="#onCloseCompose" styleClass="button-danger" minWidth="-Infinity"/>
            </HBox>
        </VBox>
    </VBox>

</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.udpchat.client.controller.ClientController" spacing="10" 
      style="-fx-background-color: #121212;">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Title Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="UDP Client" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Region fx:id="statusIndicator" styleClass="status-indicator, status-offline" prefWidth="12" prefHeight="12"/>
        <Label fx:id="statusLabel" text="OFFLINE" textFill="#888888" style="-fx-font-weight: bold;"/>
    </HBox>

    <!-- Connection Section -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="section-panel">
        <Label text="Server:" textFill="#dddddd"/>
        <TextField fx:id="serverHostField" promptText="localhost"/>
        <Label text="Port:" textFill="#dddddd"/>
        <TextField fx:id="portField" prefWidth="70" promptText="8888"/>
    </HBox>

    <!-- Authentication Section -->
    <VBox spacing="10" styleClass="section-panel">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Username:" textFill="#dddddd" prefWidth="70"/>
            <TextField fx:id="usernameField" promptText="Username"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Password:" textFill="#dddddd" prefWidth="70"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="registerButton" text="Register" onAction="#onRegister"/>
            <Button fx:id="loginButton" text="Login" onAction="#onLogin"/>
            <Button fx:id="logoutButton" text="Logout" onAction="#onLogout"/>
        </HBox>
    </VBox>

    <!-- Chat Section -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="section-panel">
        <TextArea fx:id="chatArea" VBox.vgrow="ALWAYS" prefRowCount="8" editable="false" styleClass="chat-area"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="messageField" HBox.hgrow="ALWAYS" promptText="Type a message..."/>
            <Button fx:id="sendButton" text="Send" onAction="#onSendMessage"/>
        </HBox>
    </VBox>

    <!-- File Transfer Section -->
    <VBox spacing="10" styleClass="section-panel">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="uploadButton" text="Upload File" onAction="#onUpload"/>
            <Button fx:id="downloadButton" text="Download" onAction="#onDownload"/>
            <Label text="Filename:" textFill="#dddddd"/>
            <TextField fx:id="filenameField" HBox.hgrow="ALWAYS" promptText="File to download"/>
        </HBox>
        <ProgressBar fx:id="progressBar" maxWidth="MAX_VALUE" progress="0.0"/>
    </VBox>

    <!-- Activity Log Section -->
    <VBox spacing="10" styleClass="section-panel">
        <Label text="Activity Log" textFill="#dddddd"/>
        <TextArea fx:id="logArea" prefRowCount="5" editable="false" styleClass="log-area, mono-text"/>
    </VBox>

</VBox>
